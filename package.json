{
  "name": "@qsp/converters",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "version": "2.0.0",
  "description": "Converters of different file formats for QSP platform",
  "keywords": [
    "qsp",
    "qsps",
    "file",
    "converter"
  ],
  "homepage": "https://github.com/QSPFoundation/converters#readme",
  "bugs": {
    "url": "https://github.com/QSPFoundation/converters/issues"
  },
  "license": "MIT",
  "author": "Sergii Kostyrko <srg.kostyrko@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QSPFoundation/converters.git"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=14"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "jest",
    "lint": "eslint .",
    "version": "node scripts/sync-version.js && git add src/version.ts",
    "prepublishOnly": "pnpm build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsdown": "~0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts"
}
